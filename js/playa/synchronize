#!/usr/bin/env ruby

# frozen_string_literal: true

require 'httparty'
require 'fileutils'
require 'json'

module Synchronize
  module_function

  PLAYA_CONFIG_URL = 'https://sfgame.net/config.json'
  PLAYA_TRANSLATION_URL = '%<prefix>s%<version>s/sfgame_%<language>s.bin'

  REGEXP_MONSTER = /^monster_name_(\d+)$/ 
  REGEXP_ITEM = /^item_type_(\d+)_(?:class_(\d+)_)?pic_(\d+)$/
  REGEXP_PET_REQUIREMENT = /^pet_requirements_(fire|water|earth|shadow|light)_(\d\d)(?:_new)?$/
  REGEXP_RAID_NAME = /^guild_raid_name_(\d+)$/
  REGEXP_ACHIEVEMENT = /^album_ach_(\d+)_title$/
  REGEXP_LOCATION = /^location_\d+$/

  LOCATION_NAMES = {
    201 => 'fort_building_name_05',
    202 => 'weapon_shop',
    203 => 'magic_shop',
    204 => 'toilet_of_arcane_gods'
  }.freeze

  # Deed number used by trophy ids (deed n has trophies 3n-2 to 3n), number 36 is unused
  DEED_NUMBERS = {
    'soul_eater' => 1,
    'gladiator' => 2,
    'dungeon_master' => 3,
    'dungeon_jesus' => 4,
    'luck_or_glory' => 5,
    'architect' => 6,
    'stoned' => 7,
    'booze_level' => 8,
    'sleep_and_earn' => 9,
    'heroic' => 10,
    'fortytwo' => 11,
    'beer_blessed' => 12,
    'hercules' => 13,
    'three_right_thumbs' => 14,
    'brainiac' => 15,
    'whirlwind' => 16,
    'golddigga' => 17,
    'immortal' => 18,
    'pentagram' => 19,
    'achiever' => 20,
    'master_brewer' => 21,
    'leaf_clover' => 22,
    'professor_gadget' => 23,
    'one_for_all' => 24,
    'tamer' => 25,
    'epic_outfit' => 26,
    'halo' => 27,
    'collector' => 28,
    'secret_sign' => 29,
    'dug_too_deep' => 30,
    'bad_luck' => 31,
    'goldie' => 32,
    'witch' => 33,
    'pizza' => 34,
    'goblin' => 35,
    'equestrianism' => 37,
    'hero_for_more_than_just_one_day' => 38,
    'plush_riot' => 39,
    'man_of_honor' => 40,
    'mushroom_expert' => 41
  }.freeze

  REGEXP_DEED_NAME = /^deed_(#{DEED_NUMBERS.keys.join('|')})_name$/
  REGEXP_DEED_DESCRIPTION = /^deed_(#{DEED_NUMBERS.keys.join('|')})_description$/
  REGEXP_HERO_TITLE = /^hero_title_type_\d+$/
  REGEXP_DEED_SHELF = /^deed_shelf_\d+$/
  REGEXP_TROPHY_TIER = /^trophy_(bronze|silver|gold)$/

  REGEXP_DUNGEON_TITLE = /^dungeon_(\d+)_title$/
  REGEXP_DUNGEON_FLOOR = /^dungeon_(\d+)_level_(\d+)_text$/
  REGEXP_QUOTES = /\A[\s"„“”«»]+|[\s"„“”«»]+\.?\z/

  DUNGEON_NAMES = {
    15 => 'tower_name'
  }.freeze

  DUNGEON_DESCRIPTIONS = {
    15 => 'tower_overview_description',
    18 => 'yt_dungeon_overview_description',
    32 => 'sandstorm_overview_description'
  }.freeze

  DUNGEON_IDS = {
    15 => 201,
    18 => 202,
    31 => nil,
    32 => 204,
    33 => 31,
    34 => 32,
    35 => 33,
    36 => 34,
    37 => 35,
    100 => 300,
    101 => 301,
    102 => 302,
    103 => 303,
    104 => nil
  }.freeze

  LANGUAGE_LIST = {
    'en' => 'en',
    'de' => 'de',
    'pl' => 'pl',
    'pt' => 'pt',
    'cs' => 'cs',
    'fr' => 'fr',
    'it' => 'it',
    'es' => 'es',
    'hu' => 'hu',
    'ch' => 'de'
  }

  def call(argv:)
    config = JSON.parse(HTTParty.get(PLAYA_CONFIG_URL).body)

    version = argv.first || config['required_client_version_min'][..3] + '00'

    # Save translations
    LANGUAGE_LIST.each do |sftools_language, playa_language|
      FileUtils.mkdir_p("lang/#{sftools_language}")

      response = HTTParty.get(format(PLAYA_TRANSLATION_URL, prefix: config['language_path'], version:, language: playa_language))
      unless response.success?
        puts "[#{sftools_language}] Failed to fetch #{playa_language}"
        puts response.body

        next
      end

      strings = decode(response.body)

      monsters = strings.select { |key, _| key.match?(REGEXP_MONSTER) }
      monsters = monsters.map do |key, text|
        [
          key[REGEXP_MONSTER, 1].to_i,
          text.split('|').first
        ]
      end.to_h

      File.write("lang/#{sftools_language}/monsters.json", JSON.pretty_generate(monsters))

      items = strings.select { |key, _| key.match?(REGEXP_ITEM) }
      items = items.map do |key, text|
        [
          key,
          text.split('|').first
        ]
      end.to_h

      File.write("lang/#{sftools_language}/items.json", JSON.pretty_generate(items))

      general = strings.select { |key, _| [REGEXP_PET_REQUIREMENT, REGEXP_RAID_NAME, REGEXP_ACHIEVEMENT, REGEXP_DEED_NAME, REGEXP_DEED_DESCRIPTION, REGEXP_HERO_TITLE, REGEXP_DEED_SHELF, REGEXP_TROPHY_TIER, REGEXP_LOCATION].any? { key.match?(_1) } }
      general = general.map do |key, text|
        parsed_key = case key
        when REGEXP_PET_REQUIREMENT
          "pet_requirement_#{%w[shadow light earth fire water].index(Regexp.last_match(1)) * 20 + Regexp.last_match(2).to_i - 1}"
        when REGEXP_RAID_NAME
          "guild_raid_#{Regexp.last_match(1).to_i}"
        when REGEXP_ACHIEVEMENT
          "achievement_#{Regexp.last_match(1).to_i - 1}"
        when REGEXP_DEED_NAME
          "deed_#{DEED_NUMBERS[Regexp.last_match(1)]}"
        when REGEXP_DEED_DESCRIPTION
          "deed_#{DEED_NUMBERS[Regexp.last_match(1)]}_description"
        else
          key
        end

        [
          parsed_key,
          text.split('|').first.gsub(/<br>/, ' ')
        ]
      end.to_h

      LOCATION_NAMES.each { |id, key| general["location_#{id}"] = strings[key] }

      File.write("lang/#{sftools_language}/general.json", JSON.pretty_generate(general))

      dungeons = {}

      strings.each do |key, text|
        next unless (match = key.match(REGEXP_DUNGEON_TITLE))

        game_id = match[1].to_i
        id = DUNGEON_IDS.fetch(game_id, game_id)
        next unless id

        title = text.split('|', 2)
        description = DUNGEON_DESCRIPTIONS[game_id] ? strings[DUNGEON_DESCRIPTIONS[game_id]] : (title[1] || strings["dungeon_#{match[1]}_comment"])

        dungeons[id] = {
          name: DUNGEON_NAMES[game_id] ? strings[DUNGEON_NAMES[game_id]] : title.first,
          description: description&.gsub(/(?:<br>)+/, ' ')&.gsub(REGEXP_QUOTES, '')
        }.compact
      end

      dungeons[203] = {
        name: strings['dungeon_15_title'],
        description: strings['twister_overview_description'].gsub(/(?:<br>)+/, ' ')
      }

      strings.each do |key, text|
        next unless (match = key.match(REGEXP_DUNGEON_FLOOR))

        id = DUNGEON_IDS.fetch(match[1].to_i, match[1].to_i)
        next unless id

        floors = (dungeons[id][:floors] ||= {})
        floors[match[2].to_i] = text.gsub(/(?:<br>)+/, ' ')
      end

      dungeons.each_value { |dungeon| dungeon[:floors] = dungeon[:floors].sort.to_h if dungeon[:floors] }

      File.write("lang/#{sftools_language}/dungeons.json", JSON.pretty_generate(dungeons.sort.to_h))
    end
  end

  def decode(text)
    bytes = text.bytes

    read_value = lambda do |bytes|
      head_len = bytes.shift.ord
      head_len += 64 * (2 * bytes.shift - 2) if bytes.first.ord <= 32
 
      bytes.shift(head_len).map(&:chr).join
    end
    
    strings = {}
    until bytes.empty?
      key = read_value.call(bytes)
      val = read_value.call(bytes)

      strings[key.force_encoding(Encoding::UTF_8)] = val.force_encoding(Encoding::UTF_8)
    end
    
    hash = Hash[strings.sort_by { |key, val| key.to_s }]
  end
  private_class_method :decode
end

Synchronize.call(argv: ARGV) if __FILE__ == $0
