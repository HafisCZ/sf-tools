{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "useTabs": false,
  "printWidth": 320,
  "ignorePatterns": ["js/**", "css/**", "res/**", "vendor/**", "endpoint/**", "*.html", "src/playa/portraits.json"],
  "overrides": [
    {
      "files": ["*.css"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
